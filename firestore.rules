rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Every document is scoped to the signed-in owner. Chat data lives under
    // chatbots/{uid}/bots/{botId}/messages/{messageId}, so the uid in the path
    // is checked against the caller for all reads and writes.
    function signedIn() {
      return request.auth != null;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /chatbots/{userId}/bots/{botId} {
      allow read, write: if owns(userId);
    }

    match /chatbots/{userId}/bots/{botId}/messages/{messageId} {
      allow read, write: if owns(userId);
    }

    // Profile documents written at sign-up. The collection is capitalised to
    // match what AuthRemoteDataSource writes.
    match /Users/{userId} {
      allow read: if owns(userId);
      allow create: if owns(userId);
      allow update: if owns(userId);
      allow delete: if false;
    }

    match /users/{userId}/moods/{moodId} {
      allow read: if owns(userId);
      allow create: if owns(userId)
        && request.resource.data.userId == userId
        && request.resource.data.id is int
        && request.resource.data.id > 0
        && request.resource.data.moodType is string
        && request.resource.data.moodType.size() > 0
        && request.resource.data.timestamp is int
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500
        && request.resource.data.updatedAt is int;
      allow update: if owns(userId)
        && request.resource.data.userId == userId
        && request.resource.data.id == resource.data.id
        && request.resource.data.moodType is string
        && request.resource.data.moodType.size() > 0
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500
        && request.resource.data.updatedAt is int;
      allow delete: if owns(userId);
    }

    match /users/{userId}/journals/{journalId} {
      allow read, write: if owns(userId);
    }

    // Deny anything not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
